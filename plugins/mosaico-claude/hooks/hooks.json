{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*__(javascript_tool|browser_batch)",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/browser-script-gate.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
